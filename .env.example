# Backend Configuration
BACKEND_URL=your_backend_url_here
GENAI_API_KEY=your_gemini_api_key
GENAI_URL=https://generativelanguage.googleapis.com

# Trello Configuration
TRELLO_API_URL=https://api.trello.com/1
TRELLO_KEY=your_trello_api_key
TRELLO_TOKEN=your_trello_token

# Pinecone Configuration (for RAG features)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENV=your_pinecone_environment
PINECONE_INDEX=your_pinecone_index

# GitHub OAuth Configuration (for Code Analysis feature)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_REDIRECT_URI=https://your-netlify-site.netlify.app/.netlify/functions/github-callback

# Netlify Configuration
URL=https://your-netlify-site.netlify.app
